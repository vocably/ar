{"transcript":"ḥaqīqah","exists":true,"definitions":["الواقع أو الأمر الثابت الذي لا شك فيه.","جوهر الشيء أو ماهيته.","الصدق والصواب في القول أو الاعتقاد."],"examples":["هذه حقيقة علمية.","اكتشف حقيقة الأمر.","تحدث عن حقيقة مشاعره."],"lemma":"حَقَّ","lemmaPos":"verb","synonyms":["واقع","صدق","صواب"],"number":"singular","pluralForm":"الحقائق","gender":"feminine","source":"حقيقة","frequency":8}