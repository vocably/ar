{"transcript":"أصل","exists":true,"definitions":["الجذر أو الأساس الذي ينبثق منه الشيء.","المنشأ أو المصدر الرئيسي لشيء ما.","النسب أو الأصل العائلي.","المبدأ أو القاعدة الأساسية."],"examples":["أصل الشجرة عميق.","ما أصل هذه الكلمة؟","هو من أصل كريم.","أصل المشكلة هو سوء الفهم."],"lemma":"أصل","lemmaPos":"noun","synonyms":["جذر","أساس","منشأ","مصدر"],"number":"singular","pluralForm":"الأصول","gender":"masculine","source":"أصل"}